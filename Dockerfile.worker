FROM golang:1.24-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -buildvcs=false -trimpath -ldflags='-s -w' -o /out/worker ./cmd/worker
FROM alpine:3.21
RUN adduser -D -u 10001 worker && mkdir -p /work && chown worker:worker /work
USER worker
WORKDIR /work
COPY --from=build /out/worker /usr/local/bin/worker
ENTRYPOINT ["worker"]
